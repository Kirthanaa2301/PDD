# MongoDB Connection URI (e.g. mongodb+srv://user:pass@cluster.mongodb.net/asthmasense or mongodb://localhost:27017/asthmasense)
MONGO_URI=your_mongodb_atlas_connection_string

# xAI Grok API Key (https://console.x.ai)
GROK_API_KEY=your_grok_api_key
GROK_MODEL=grok-2

# Groq API Key for Whisper audio transcription & fallback
GROQ_API_KEY=your_groq_api_key

# JWT Secret for User Auth
JWT_SECRET=any_long_random_string

# Server Port (default: 5000)
PORT=5000
